{
  "info": {
    "name": "MailFlow (go-mail-sender) API",
    "description": "Every endpoint of the go-mail-sender API (see the API table in README.md).\n\n1. Set `baseUrl` (default http://localhost:8080). File uploads use `samples/9_mixed_everything.xlsx`: in Postman, Settings -> General -> Working directory, choose the repository folder, or pick a file again in the request's Body tab.\n2. Requests that create something save their id (`batch_id`, `job_id`, `next_after`) for the requests after them.\n3. Requests marked **really sends** send email through the configured SMTP server.\n\nErrors are JSON: `{\"error\": \"message\"}`. There is no login yet.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "next_after",
      "value": ""
    },
    {
      "key": "batch_id",
      "value": ""
    },
    {
      "key": "job_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Liveness check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/healthz",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "healthz"
              ]
            },
            "description": "Reports that the server process is up. Answer: `200 {\"status\":\"ok\"}`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Single email",
      "item": [
        {
          "name": "Send one email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/emails",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "emails"
              ]
            },
            "description": "Sends one email right away (not queued) through the configured SMTP server. **This really sends**: change `to` first. Answer: `200 {\"message\":\"email sent\"}`, `400` for invalid input, `502` when SMTP fails.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"to\": \"you@example.com\",\n  \"subject\": \"Hello from MailFlow\",\n  \"body\": \"This is a test email.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Verify Emails (verify)",
      "description": "Check a spreadsheet without sending. The upload answers `202` at once; the file is checked in the background. Poll the batch until `status` is `completed` (or `import_failed`).",
      "item": [
        {
          "name": "Upload a file to check",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "verify"
              ]
            },
            "description": "Streams the file to the server and starts the background check. `202 {\"batch_id\",\"type\":\"verification\",\"filename\",\"status\":\"importing\"}`; `400` not an .xlsx, `413` over the size limit.\n\nThe test script saves `batch_id`.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "samples/9_mixed_everything.xlsx",
                  "description": "A .xlsx file: first sheet, header row with \"name\" and \"email\". Up to MAX_UPLOAD_MB (default 10 MB). If Postman cannot find it, pick the file again here."
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 202', () => pm.response.to.have.status(202));",
                  "const up = pm.response.json();",
                  "pm.test('has a batch_id', () => pm.expect(up.batch_id).to.be.a('number'));",
                  "pm.collectionVariables.set('batch_id', up.batch_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get progress and totals",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/verify/{{batch_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "verify",
                "{{batch_id}}"
              ]
            },
            "description": "The batch: `status` (`importing` -> `completed`), `processed_rows` while importing, then `total_rows`, `valid_count`, `unverified_count`, `invalid_count`, `invalid_counts` per reason, `import_error`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "List problems (first page)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/verify/{{batch_id}}/issues?limit=100",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "verify",
                "{{batch_id}}",
                "issues"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "100",
                  "description": "1-500 (default 100)."
                },
                {
                  "key": "status",
                  "value": "unverified",
                  "description": "invalid (default) or unverified.",
                  "disabled": true
                },
                {
                  "key": "q",
                  "value": "",
                  "description": "Part of the name or email.",
                  "disabled": true
                }
              ]
            },
            "description": "Invalid rows in spreadsheet order: `{\"items\":[{\"id\",\"row\",\"name\",\"email\",\"validation_status\",\"validation_reason\"}],\"next_after\"}`. The test script saves `next_after`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const page = pm.response.json();",
                  "pm.collectionVariables.set('next_after', page.next_after ?? '');"
                ]
              }
            }
          ]
        },
        {
          "name": "List problems (next page)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/verify/{{batch_id}}/issues?after={{next_after}}&limit=100",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "verify",
                "{{batch_id}}",
                "issues"
              ],
              "query": [
                {
                  "key": "after",
                  "value": "{{next_after}}",
                  "description": "The previous page's next_after."
                },
                {
                  "key": "limit",
                  "value": "100",
                  "description": ""
                }
              ]
            },
            "description": "The page after `next_after` (send it back as `after`)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "List one tab (Invalid)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/verify/{{batch_id}}/issues?reason=empty_email,empty_name,invalid_email&limit=100",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "verify",
                "{{batch_id}}",
                "issues"
              ],
              "query": [
                {
                  "key": "reason",
                  "value": "empty_email,empty_name,invalid_email",
                  "description": ""
                },
                {
                  "key": "limit",
                  "value": "100",
                  "description": ""
                }
              ]
            },
            "description": "Only these reasons (comma separated): empty_email, empty_name, invalid_email, bad_domain."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Bulk Emails (batches)",
      "description": "Upload, review, explicitly send, follow, cancel, retry. A checked verification batch is sent with the same `send` request.",
      "item": [
        {
          "name": "Upload a file to send to",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/batches",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "batches"
              ]
            },
            "description": "Like Verify; the batch ends as `draft` after its check. The test script saves `batch_id`.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "samples/9_mixed_everything.xlsx",
                  "description": "A .xlsx file: first sheet, header row with \"name\" and \"email\". Up to MAX_UPLOAD_MB (default 10 MB). If Postman cannot find it, pick the file again here."
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 202', () => pm.response.to.have.status(202));",
                  "const up = pm.response.json();",
                  "pm.collectionVariables.set('batch_id', up.batch_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get batch",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/batches/{{batch_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "batches",
                "{{batch_id}}"
              ]
            },
            "description": "Status, counters, import and delivery progress. Cheap; the dashboard polls it."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "List Bulk Emails",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/batches?type=bulk_send&limit=20&offset=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "batches"
              ],
              "query": [
                {
                  "key": "type",
                  "value": "bulk_send",
                  "description": "verification or bulk_send."
                },
                {
                  "key": "status",
                  "value": "",
                  "description": "importing, import_failed, draft, generating_jobs, queued, sending, completed, completed_with_errors, failed, cancelled.",
                  "disabled": true
                },
                {
                  "key": "q",
                  "value": "",
                  "description": "Part of the filename.",
                  "disabled": true
                },
                {
                  "key": "limit",
                  "value": "20",
                  "description": "1-100."
                },
                {
                  "key": "offset",
                  "value": "0",
                  "description": ""
                }
              ]
            },
            "description": "Newest first: `{\"items\",\"total\",\"limit\",\"offset\"}`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Preview sample",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/batches/{{batch_id}}/sample?limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "batches",
                "{{batch_id}}",
                "sample"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "5",
                  "description": "1-20 (default 5)."
                }
              ]
            },
            "description": "First rows that will be sent, for the preview."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "List problems",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/batches/{{batch_id}}/issues?limit=100",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "batches",
                "{{batch_id}}",
                "issues"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "100",
                  "description": ""
                }
              ]
            },
            "description": "Same as the Verify request."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Send (really sends)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/batches/{{batch_id}}/send",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "batches",
                "{{batch_id}}",
                "send"
              ]
            },
            "description": "**Really sends** once the emails are created. Saves the templates and starts job generation: `202` batch with `status\":\"generating_jobs\"`. `400` bad template (only {{.Name}} and {{.Email}}), `409` already sent / still importing / nothing to send.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject\": \"Update on your order, {{.Name}}\",\n  \"body\": \"Hello {{.Name}},\\n\\nYour order is on its way.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 202', () => pm.response.to.have.status(202));"
                ]
              }
            }
          ]
        },
        {
          "name": "List emails",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/batches/{{batch_id}}/emails?limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "batches",
                "{{batch_id}}",
                "emails"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20",
                  "description": "1-100 (default 20)."
                },
                {
                  "key": "status",
                  "value": "",
                  "description": "pending, processing, sent, failed or cancelled.",
                  "disabled": true
                },
                {
                  "key": "q",
                  "value": "",
                  "description": "Part of the email or name.",
                  "disabled": true
                },
                {
                  "key": "after",
                  "value": "",
                  "description": "next_after of the previous page.",
                  "disabled": true
                }
              ]
            },
            "description": "One page of the batch's emails with their state and the built subject/body: `{\"items\",\"next_after\"}`. The test script saves the first email's id as `job_id`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const page = pm.response.json();",
                  "if (page.items.length) pm.collectionVariables.set('job_id', page.items[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Retry failed emails",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/batches/{{batch_id}}/retry",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "batches",
                "{{batch_id}}",
                "retry"
              ]
            },
            "description": "Requeue every failed email: `{\"retried\":N}`; `409` if the batch was cancelled."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancel (stop sending)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/batches/{{batch_id}}/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "batches",
                "{{batch_id}}",
                "cancel"
              ]
            },
            "description": "Stop a batch that is preparing or sending: `{\"cancelled\":N}`; `409` when there is nothing to stop."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 or 409', () => pm.expect(pm.response.code).to.be.oneOf([200, 409]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Retry one email",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/jobs/{{job_id}}/retry",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "jobs",
                "{{job_id}}",
                "retry"
              ]
            },
            "description": "Requeue one failed email: `{\"retried\":1}`; `404` if it is not failed."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 or 404', () => pm.expect(pm.response.code).to.be.oneOf([200, 404]));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Overview numbers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/stats?days=14&tz=Asia/Dhaka",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "stats"
              ],
              "query": [
                {
                  "key": "days",
                  "value": "14",
                  "description": "1-90 (default 14)."
                },
                {
                  "key": "tz",
                  "value": "Asia/Dhaka",
                  "description": "IANA time zone for \"today\" (default UTC)."
                }
              ]
            },
            "description": "Today's sent and failed, the queue, a daily series and the batches that need attention."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Settings",
      "description": "Runtime settings. Secrets (SMTP password) are never returned.",
      "item": [
        {
          "name": "List settings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/settings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "settings"
              ]
            },
            "description": "Every editable setting with its value, source (env or override), how it applies (instant, restart, readonly) and whether a restart is pending."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Change settings",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/settings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "settings"
              ]
            },
            "description": "All-or-nothing. `values` sets, `reset` goes back to the .env value. Changing SMTP settings first opens a real connection and refuses the save if it fails. Example: raise the upload limit to 40 MB.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"values\": {\n    \"MAX_UPLOAD_MB\": \"40\"\n  },\n  \"reset\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Send a test email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/settings/smtp/test",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "settings",
                "smtp",
                "test"
              ]
            },
            "description": "Sends a real test email over a fresh SMTP connection. Fields you leave out use the current settings, so unsaved values can be tried first. **This really sends**: change `to`. Answer: `200`, or `502` with the SMTP reason.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"to\": \"you@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
  ]
}
