# Database connection string (PostgreSQL)
DATABASE_URL=postgres://localhost:5432/sendmail?sslmode=disable

# Mailpit SMTP settings (default localhost:1025, auth is optional)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=

# Sender address used for outgoing email
MAIL_FROM=hello@example.com

# HTTP API server port
HTTP_ADDR=:8080

# Concurrency & Pool options
WORKER_COUNT=3
SMTP_POOL_SIZE=3
JOB_POLL_INTERVAL=500ms
MAX_JOB_RETRIES=3
