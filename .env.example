# Database connection string (PostgreSQL)
DATABASE_URL=postgres://localhost:5432/sendmail?sslmode=disable

# Mailpit SMTP settings (default localhost:1025, auth is optional)
SMTP_HOST=localhost
SMTP_PORT=1025

# Encryption to the SMTP server:
#   auto     - upgrade with STARTTLS if the server offers it (default)
#   none     - never encrypt (local Mailpit)
#   starttls - require STARTTLS (typical for port 587)
#   tls      - implicit TLS from the first byte (typical for port 465)
SMTP_TLS_MODE=auto
SMTP_USERNAME=
SMTP_PASSWORD=

# Sender address used for outgoing email
MAIL_FROM=hello@example.com

# HTTP API server port
HTTP_ADDR=:8080

# HTTP timeouts (Go duration, e.g. 90s, 5m, 1h). Kept high so large uploads
# with domain checks do not get cut off. HTTP_READ_TIMEOUT covers receiving the
# whole request (including the file); HTTP_WRITE_TIMEOUT is the max time a
# handler may take before its response must be written.
HTTP_READ_TIMEOUT=5m
HTTP_WRITE_TIMEOUT=15m

# Check that recipient domains can receive mail (DNS MX / A lookup). true/false
DOMAIN_CHECK_ENABLED=true

# Concurrency & Pool options
WORKER_COUNT=3
SMTP_POOL_SIZE=3
JOB_POLL_INTERVAL=500ms
MAX_JOB_RETRIES=3

# Browser origins allowed to call the API (the dashboard URL), comma-separated.
# "*" allows any origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Key for encrypting secrets edited in the dashboard (the SMTP password).
# Generate one with: openssl rand -base64 32
# Keep it stable: changing it makes stored secrets unreadable.
SETTINGS_ENCRYPTION_KEY=
