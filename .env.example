# Mailtrap sandbox SMTP credentials (Mailtrap -> Email Testing -> Inboxes -> SMTP settings)
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USERNAME=
MAILTRAP_PASSWORD=

# Sender address used for every email
MAIL_FROM=hello@example.com

# Where the API listens (optional, default :8080)
HTTP_ADDR=:8080
